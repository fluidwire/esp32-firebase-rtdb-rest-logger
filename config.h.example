// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- Firebase Realtime Database ---------------------------------------------
// Host only, no https:// and no trailing slash. Examples:
//   "your-project-default-rtdb.firebaseio.com"
//   "your-project-default-rtdb.asia-southeast1.firebasedatabase.app"
#define FIREBASE_HOST   "your-project-default-rtdb.firebaseio.com"

// Database secret or ID token, sent as ?auth=<token>.
// For a quick test, use test-mode rules and leave this empty.
// For real use, lock your rules down and use a per-device token.
#define FIREBASE_AUTH   ""

// Path the readings are pushed under, and the path read back for remote config.
#define LOG_PATH        "/devices/fluidwire-esp32-01/readings"
#define CONFIG_PATH     "/devices/fluidwire-esp32-01/config/interval_s"
